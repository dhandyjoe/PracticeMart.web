{
  "name": "practicemart-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --project demo-practicemart",
    "test:rules": "firebase emulators:exec --only firestore --project demo-practicemart 'vitest run tests/rules'",
    "test": "vitest run src",
    "test:coverage": "vitest run src --coverage",
    "test:integration": "firebase emulators:exec --only auth,firestore --project demo-practicemart 'VITE_USE_EMULATOR=1 VITE_FIREBASE_PROJECT_ID=demo-practicemart VITE_FIREBASE_API_KEY=demo-key vitest run tests/integration --no-file-parallelism --testTimeout=20000'",
    "dev:bank": "vite bank --port 5174 --strictPort",
    "deploy:app": "npm run build && firebase deploy --only hosting:app",
    "deploy:bank": "firebase deploy --only hosting:bank",
    "deploy": "npm run lint && npm test && npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "firebase": "^13.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.1",
    "firebase-tools": "^15.37.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
